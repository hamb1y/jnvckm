---
import Figure from "@/components/Figure.astro";
import PageCover from "@/components/PageCover.astro";
import { pages } from "@/data/pages";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const { photo, facts, founded } = pages.vidyalaya;
---

<PageCover title={t(lang, "vidyalaya.title")} lede={t(lang, "vidyalaya.lede")}>
  <p class="cover-mark" slot="figure" aria-hidden="true">
    {founded}
  </p>
</PageCover>

<div class="container vidyalaya">
  {photo && <Figure media={photo} locale={lang} ratio="16 / 9" />}

  <dl class="fact-sheet">
    {facts.map((fact) => (
      <div class:list={["fact", fact.wide && "fact--wide"]}>
        <dt>{lx(fact.label, lang)}</dt>
        <dd class="fact-value">{lx(fact.value, lang)}</dd>
        {lx(fact.note, lang) !== "" && <dd class="fact-note">{lx(fact.note, lang)}</dd>}
      </div>
    ))}
  </dl>

  <div class="vidyalaya-links">
    <p>
      <a href="https://navodaya.gov.in" rel="noopener">
        navodaya.gov.in
      </a>
      {" — "}
      {lang === "kn" ? "ಅಧಿಕೃತ ಶಾಲಾ ಜಾಲತಾಣ" : "the school's official website"}
    </p>
    <p>
      <a href={localePath("/about", lang)}>{t(lang, "about.title")}</a>
    </p>
  </div>
</div>

<style>
  .cover-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.5rem, 2.5rem + 8vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--gold);
    justify-self: end;
  }

  .vidyalaya {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
  }

  .fact-sheet {
    margin: var(--s-8) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block-start: 2px solid var(--ink);
  }

  .fact {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-5) var(--s-6) 0;
    border-block-end: 1px solid var(--rule);
  }

  .fact--wide {
    grid-column: 1 / -1;
  }

  .fact dt {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent-program);
  }

  .fact-value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }

  .fact--wide .fact-value {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.5;
    letter-spacing: 0;
    max-inline-size: 60ch;
  }

  .fact-note {
    color: var(--text-2);
    max-inline-size: 36ch;
  }

  :global(:lang(kn)) .fact-value {
    letter-spacing: 0;
    line-height: 1.35;
  }

  .vidyalaya-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    margin-block-start: var(--s-7);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .cover-mark {
      justify-self: start;
    }

    .fact-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .fact-sheet {
      grid-template-columns: 1fr;
    }

    .fact {
      padding-inline-end: 0;
    }
  }
</style>
