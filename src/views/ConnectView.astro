---
import { ArrowUpRight } from "lucide-astro";
import PageCover from "@/components/PageCover.astro";
import { pages } from "@/data/pages";
import { posts } from "@/data/posts";
import { site } from "@/data/site";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const batchReps = posts.find((entry) => entry.slug === pages.connect.batchReps);
---

<PageCover title={t(lang, "connect.title")} lede={t(lang, "connect.lede")} />

<section class="accent-brand">
  <div class="container connect">
    <div class="connect-main">
      <article>
        <h2>{t(lang, "connect.volunteerTitle")}</h2>
        <p>{t(lang, "connect.volunteerBody")}</p>
      </article>

      <article>
        <h2>{t(lang, "connect.batchRepsTitle")}</h2>
        <p>{t(lang, "connect.batchRepsBody")}</p>
        {batchReps && (
          <a class="more" href={localePath(`/stories/${batchReps.slug}`, lang)}>
            {t(lang, "connect.batchRepsLink")}
            <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
          </a>
        )}
      </article>

      <article>
        <h2>{t(lang, "connect.contributeTitle")}</h2>
        <p>{lx(site.donations.note, lang)}</p>
      </article>
    </div>

    <aside class="connect-card">
      <h2>{t(lang, "connect.routeTitle")}</h2>
      <p>{t(lang, "connect.routeBody")}</p>
      <div class="connect-school">
        <h3>{t(lang, "nav.vidyalaya")}</h3>
        <address>{lx(site.contact.address, lang)}</address>
      </div>
    </aside>
  </div>
</section>

<style>
  .connect {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(var(--s-7), 6vw, var(--s-10));
    align-items: start;
  }

  .connect-main {
    display: grid;
    border-block-start: 2px solid var(--ink);
  }

  .connect-main article {
    padding-block: var(--s-6);
    border-block-end: 1px solid var(--rule);
  }

  .connect-main h2 {
    font-size: var(--step-3);
    margin-block-end: var(--s-3);
  }

  .connect-main p {
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.55;
    max-inline-size: 50ch;
  }

  .connect-main .more {
    margin-block-start: var(--s-4);
  }

  /* The route in, on the association's own olive. */
  .connect-card {
    position: sticky;
    inset-block-start: calc(var(--header-h) + var(--s-5));
    padding: clamp(var(--s-5), 4vw, var(--s-7));
    background: var(--brand);
    color: var(--brand-ink);
    border-radius: var(--r-4);
  }

  .connect-card h2 {
    font-size: var(--step-3);
    margin-block-end: var(--s-4);
  }

  .connect-card > p {
    color: var(--brand-muted);
  }

  .connect-school {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--brand-rule);
  }

  .connect-school h3 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--gold);
    margin-block-end: var(--s-2);
  }

  .connect-school address {
    font-style: normal;
    font-size: var(--step-1);
    color: var(--brand-ink);
    max-inline-size: 34ch;
  }

  @media (max-width: 900px) {
    .connect {
      grid-template-columns: 1fr;
    }

    .connect-card {
      position: static;
    }
  }
</style>
