---
import EntryRow from "@/components/EntryRow.astro";
import PageCover from "@/components/PageCover.astro";
import { formatCount } from "@/utils/format";
import { events } from "@/data/events";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const upcoming = events
  .filter((entry) => entry.date !== "" && entry.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
const past = events.filter((entry) => entry.date !== "" && entry.date < today);

// Group by year so a long record stays navigable.
const years = [...new Set(past.map((entry) => entry.date.slice(0, 4)))];
const byYear = years.map((year) => ({
  year,
  entries: past.filter((entry) => entry.date.startsWith(year)),
}));
// "Past" only means something beside an "Upcoming" list; alone, the years are
// the section headings.
const YearHeading = upcoming.length > 0 ? "h3" : "h2";
---

<PageCover title={t(lang, "events.title")} lede={t(lang, "events.lede")}>
  <div class="cover-figure" slot="figure">
    <span class="cover-figure-value">{formatCount(events.length, lang)}</span>
    {years.length > 0 && (
      <span class="cover-figure-note">
        {years.at(-1)}–{years[0]}
      </span>
    )}
  </div>
</PageCover>

{upcoming.length > 0 && (
  <section class="accent-brand">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">{t(lang, "events.upcoming")}</h2>
      </div>
      <ul class="records">
        {upcoming.map((entry) => (
          <EntryRow
            href={localePath(`/events/${entry.slug}`, lang)}
            title={lx(entry.title, lang)}
            date={entry.date}
            summary={lx(entry.summary, lang)}
            image={entry.image}
            meta={entry.location ? [lx(entry.location, lang)] : []}
            locale={lang}
          />
        ))}
      </ul>
    </div>
  </section>
)}

<section class="accent-brand">
  <div class="container">
    {upcoming.length > 0 && (
      <div class="section-head">
        <h2 class="section-title">{t(lang, "events.past")}</h2>
      </div>
    )}
    {byYear.map(({ year, entries }) => (
      <div class="year-group">
        <YearHeading class="year">{year}</YearHeading>
        <ul class="records">
          {entries.map((entry) => (
            <EntryRow
              href={localePath(`/events/${entry.slug}`, lang)}
              title={lx(entry.title, lang)}
              date={entry.date}
              summary={lx(entry.summary, lang)}
              image={entry.image}
              meta={entry.location ? [lx(entry.location, lang)] : []}
              locale={lang}
              omitYear
            />
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  section {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
  }

  section:last-of-type {
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }

  .container .section-head {
    margin-block-end: var(--s-6);
  }

  .section-title {
    font-size: var(--step-4);
  }

  /* A timeline: each year set large in the report gold, pinned beside its
     records while you read through them. */
  .year-group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  /* One continuous record: a year break is a heavier rule, not a gap with
     two hairlines in it. */
  .year-group {
    border-block-start: 2px solid var(--ink);
  }

  .year-group:not(:last-child) :global(.ledger-row:last-child) {
    border-block-end: 0;
  }

  .year-group :global(.ledger-row:first-child) {
    border-block-start: 0;
  }

  .year {
    position: sticky;
    inset-block-start: calc(var(--header-h) + var(--s-5));
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 2.6vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-program);
    padding-block: var(--s-5);
  }

  @media (max-width: 720px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }

    .year {
      position: static;
    }
  }
</style>
