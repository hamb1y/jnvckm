---
import EntryRow from "@/components/EntryRow.astro";
import { events } from "@/data/events";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import { formatDate } from "@/utils/format";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const upcoming = events
  .filter((entry) => entry.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
const past = events.filter((entry) => entry.date < today);
---

<div class="container">
  <header class="page-head">
    <h1>{t(lang, "events.title")}</h1>
    <p>{t(lang, "events.lede")}</p>
  </header>
</div>

<section class="accent-brand">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">{t(lang, "events.upcoming")}</h2>
    </div>
    {
      upcoming.length > 0 ? (
        <ul class="records">
          {upcoming.map((entry) => (
            <EntryRow
              href={localePath(`/events/${entry.slug}`, lang)}
              title={lx(entry.title, lang)}
              date={formatDate(entry.date, lang)}
              summary={lx(entry.summary, lang)}
              image={entry.image}
              meta={entry.location ? [lx(entry.location, lang)] : []}
              locale={lang}
            />
          ))}
        </ul>
      ) : (
        <p class="empty-state">{t(lang, "events.empty")}</p>
      )
    }
  </div>
</section>

{
  past.length > 0 && (
    <section class="accent-brand">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">{t(lang, "events.past")}</h2>
        </div>
        <ul class="records">
          {past.map((entry) => (
            <EntryRow
              href={localePath(`/events/${entry.slug}`, lang)}
              title={lx(entry.title, lang)}
              date={formatDate(entry.date, lang)}
              summary={lx(entry.summary, lang)}
              image={entry.image}
              meta={entry.location ? [lx(entry.location, lang)] : []}
              locale={lang}
            />
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .container {
    padding-block-start: clamp(2rem, 5vw, 4rem);
  }

  section {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }

  .container .section-head {
    margin-block-end: var(--s-5);
  }
</style>
