---
import Figure from "@/components/Figure.astro";
import { programs } from "@/data/programs";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<div class="container">
  <header class="page-head">
    <h1>{t(lang, "programs.title")}</h1>
    <p>{t(lang, "programs.lede")}</p>
  </header>
</div>

<section class="accent-program">
  <div class="container">
    <div class="programs">
      {
        programs.map((program, index) => (
          <article
            class:list={[
              "program",
              index % 2 === 1 && "program--flip",
              program.image === null && "program--text",
            ]}
          >
            {program.image && (
              <div class="program-media">
                <Figure media={program.image} locale={lang} ratio="4 / 3" />
              </div>
            )}
            <div class="program-main">
              <h2>
                <a href={localePath(`/programs/${program.id}`, lang)}>{lx(program.name, lang)}</a>
              </h2>
              <p class="program-tagline">{lx(program.tagline, lang)}</p>
              <p class="program-summary">{lx(program.summary, lang)}</p>
              <p class="program-note mono">{lx(program.startNote, lang)}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs {
    display: grid;
  }

  .program {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: center;
    padding-block: clamp(var(--s-6), 4vw, var(--s-8));
  }

  .program--flip .program-media {
    order: 2;
  }

  /* A program with no photograph gets the row to itself. */
  .program--text {
    grid-template-columns: minmax(0, 1fr);
  }

  .program--text .program-main {
    max-inline-size: 46rem;
  }

  .program-main h2 {
    max-inline-size: 18ch;
  }

  .program-main h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .program-main h2 a:hover {
    color: var(--accent);
  }

  .program-tagline {
    margin-block-start: var(--s-2);
    font-weight: 600;
    color: var(--accent);
  }

  .program-summary {
    margin-block-start: var(--s-4);
    color: var(--text-2);
    max-inline-size: 54ch;
  }

  .program-note {
    margin-block-start: var(--s-5);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--rule);
    color: var(--text-3);
    max-inline-size: 54ch;
  }

  @media (max-width: 900px) {
    .program {
      grid-template-columns: 1fr;
    }

    .program--flip .program-media {
      order: 0;
    }
  }
</style>
