---
import { ArrowRight, ArrowUpRight } from "lucide-astro";
import Band from "@/components/Band.astro";
import CTABand from "@/components/CTABand.astro";
import EntryCard from "@/components/EntryCard.astro";
import Figure from "@/components/Figure.astro";
import { recentActivity } from "@/data/activity";
import { contributions } from "@/data/contributions";
import { events } from "@/data/events";
import { programs } from "@/data/programs";
import { site } from "@/data/site";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import { formatAmount, formatDate } from "@/utils/format";
import { formatCount } from "@/utils/format";
import type { Locale, Media } from "@/data/types";
import type { UIKey } from "@/i18n/ui";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const KIND_LABEL: Record<string, UIKey> = {
  news: "posts.kind.news",
  report: "posts.kind.report",
  story: "posts.kind.story",
  event: "nav.events",
};

const hero: Media = {
  src: "/images/hero-1.webp",
  alt: {
    en: "Students in uniform walking together along a campus path.",
    kn: "ಶಾಲಾ ಸಮವಸ್ತ್ರದಲ್ಲಿ ವಿದ್ಯಾರ್ಥಿಗಳು ಆವರಣದ ಹಾದಿಯಲ್ಲಿ ಜೊತೆಯಾಗಿ ನಡೆಯುತ್ತಿದ್ದಾರೆ.",
  },
  caption: {
    en: "On the campus at Seegodu.",
    kn: "ಸೀಗೋಡುವಿನ ಆವರಣದಲ್ಲಿ.",
  },
};

const lab: Media = {
  src: "/images/img-20181205-wa0096.webp",
  alt: {
    en: "Tables, stools and STEM artwork inside the Atal Tinkering Lab.",
    kn: "ಅಟಲ್ ಟಿಂಕರಿಂಗ್ ಲ್ಯಾಬ್ ಒಳಗೆ ಮೇಜುಗಳು, ಸ್ಟೂಲ್‌ಗಳು ಮತ್ತು ವಿಜ್ಞಾನ ಕಲಾಕೃತಿಗಳು.",
  },
};

// The giving record, newest first, with one photograph to lead it. Records with
// no recorded figure keep their row and an empty figure column, so the list and
// the count above it agree.
const giving = contributions;
const givingYears = contributions.map((entry) => entry.date.slice(0, 4)).sort();
const givingSummary = t(lang, "impact.summary")
  .replace("{count}", formatCount(contributions.length, lang))
  .replace("{from}", givingYears[0] ?? "")
  .replace("{to}", givingYears.at(-1) ?? "");

// Newest first, and NOT filtered by whether a photograph exists: freshness
// decides the order, and a record without a photograph gets a text card.
const latest = recentActivity(10)
  .filter((item) => item.kind !== "contribution")
  .slice(0, 3);

const ignite = programs.find((program) => program.id === "ignite");
const ncl = programs.find((program) => program.id === "ncl");
const hamRadio = events.find((entry) => entry.slug === "ham-radio-workshop-2015");

const campus: Media = {
  src: "/images/img2.webp",
  alt: {
    en: "Students seated in rows in the school hall.",
    kn: "ಶಾಲಾ ಸಭಾಂಗಣದಲ್ಲಿ ಸಾಲಾಗಿ ಕುಳಿತಿರುವ ವಿದ್ಯಾರ್ಥಿಗಳು.",
  },
};
---

<article class="home">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow accent-brand">{t(lang, "site.formedShort")}</p>
        <h1>{lx(site.name, lang)}</h1>
        <p class="hero-line">{lx(site.tagline, lang)}</p>
        <p class="hero-body">{t(lang, "home.heroBody")}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={localePath("/contributions", lang)}>
            {t(lang, "home.explore")}
            <ArrowRight size={17} stroke-width={1.7} aria-hidden="true" />
          </a>
          <a class="btn btn-secondary" href={localePath("/events", lang)}>
            {t(lang, "home.latestCta")}
          </a>
        </div>
      </div>

      <div class="hero-media">
        <Figure media={hero} locale={lang} ratio="4 / 3" priority={true} showCaption={true} />
      </div>
    </div>
  </section>

  <section class="accent-give">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t(lang, "home.impactTitle")}</h2>
          <p class="section-lede">{givingSummary}</p>
        </div>
        <a class="more" href={localePath("/contributions", lang)}>
          {t(lang, "common.allContributions")}
          <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>

      <div class="giving">
        <div class="giving-media">
          <Figure media={lab} locale={lang} ratio="4 / 3" showCaption={true} />
        </div>
        <div class="giving-copy">
          <ul class="ledger">
            {
              giving.map((entry) => (
                <li>
                  <span class="label">
                    <a href={localePath(`/contributions/${entry.slug}`, lang)}>
                      {lx(entry.title, lang)}
                    </a>
                    {entry.batch && <span class="batch mono"> · {lx(entry.batch, lang)}</span>}
                  </span>
                  <span class="value">
                    {entry.amount !== null ? formatAmount(entry.amount, lang) : ""}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {
    hamRadio && hamRadio.image && (
      <Band
        href={localePath(`/events/${hamRadio.slug}`, lang)}
        src={hamRadio.image.src}
        alt={lx(hamRadio.image.alt, lang)}
        caption={lx(hamRadio.title, lang)}
        meta={formatDate(hamRadio.date, lang)}
      />
    )
  }

  <section class="accent-program">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">{t(lang, "programs.title")}</h2>
        <p class="section-lede">{t(lang, "programs.lede")}</p>
      </div>

      <div class="programs">
        {
          ignite && (
            <article class="program">
              <div class="program-media">
                <Figure media={ignite.image} locale={lang} ratio="4 / 3" />
              </div>
              <div class="program-main">
                <p class="eyebrow">{lx(ignite.name, lang)}</p>
                <h3>
                  <a href={localePath("/programs/ignite", lang)}>{lx(ignite.tagline, lang)}</a>
                </h3>
                <p>{lx(ignite.summary, lang)}</p>
                <p class="program-note mono">{lx(ignite.startNote, lang)}</p>
                <a class="more" href={localePath("/programs/ignite", lang)}>
                  {t(lang, "programs.more").replace("{name}", lx(ignite.name, lang))}
                  <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
                </a>
              </div>
            </article>
          )
        }
        {
          ncl && (
            <article class="program program--panel">
              <div class="program-panel">
                <p class="panel-mark mono">{ncl.shortName ? lx(ncl.shortName, lang) : ""}</p>
                <p class="panel-name">{lx(ncl.name, lang)}</p>
                <p class="panel-years mono">{lx(ncl.startNote, lang)}</p>
              </div>
              <div class="program-main">
                <p class="eyebrow">{lx(ncl.name, lang)}</p>
                <h3>
                  <a href={localePath("/programs/ncl", lang)}>{lx(ncl.tagline, lang)}</a>
                </h3>
                <p>{lx(ncl.summary, lang)}</p>
                <a class="more" href={localePath("/programs/ncl", lang)}>
                  {t(lang, "programs.more").replace("{name}", lx(ncl.name, lang))}
                  <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
                </a>
              </div>
            </article>
          )
        }
      </div>
    </div>
  </section>

  <section class="accent-brand">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">{t(lang, "home.latestTitle")}</h2>
        <a class="more" href={localePath("/events", lang)}>
          {t(lang, "common.allEvents")}
          <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>
      {
        latest.length > 0 ? (
          <div class="recent-grid">
            {latest.map((item) => (
              <EntryCard
                href={localePath(item.path, lang)}
                title={lx(item.title, lang)}
                summary={lx(item.summary, lang)}
                date={item.date}
                label={t(lang, KIND_LABEL[item.kind])}
                image={item.image}
                locale={lang}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">{t(lang, "empty.generic")}</p>
        )
      }
    </div>
  </section>

  <section class="accent-brand">
    <div class="container origin">
      <div class="origin-media">
        <Figure media={campus} locale={lang} ratio="4 / 3" />
      </div>
      <div class="origin-copy">
        <p class="eyebrow">{t(lang, "nav.vidyalaya")}</p>
        <h2>{t(lang, "home.vidyalayaTitle")}</h2>
        <p>{t(lang, "home.vidyalayaLede")}</p>
        <a class="more" href={localePath("/vidyalaya", lang)}>
          {t(lang, "nav.vidyalaya")}
          <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <CTABand
    kicker={t(lang, "site.formedShort")}
    title={t(lang, "home.connectTitle")}
    body={t(lang, "home.connectLede")}
    primaryHref={localePath("/connect", lang)}
    primaryLabel={t(lang, "home.reconnect")}
    secondaryHref={localePath("/about", lang)}
    secondaryLabel={t(lang, "nav.about")}
  />
</article>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: start;
  }

  .hero-copy h1 {
    margin-block-start: var(--s-4);
    max-inline-size: 16ch;
  }

  .hero-line {
    margin-block-start: var(--s-5);
    font-size: var(--step-2);
    color: var(--text-2);
    max-inline-size: 30ch;
  }

  .hero-body {
    margin-block-start: var(--s-4);
    color: var(--text-2);
    max-inline-size: 52ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  .giving {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--s-6), 4vw, var(--s-8));
    align-items: start;
  }

  .ledger .batch {
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .programs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: clamp(var(--s-6), 4vw, var(--s-8));
  }

  .program {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .program-main h3 {
    margin-block: var(--s-2) var(--s-3);
    max-inline-size: 20ch;
  }

  .program-main h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .program-main h3 a:hover {
    color: var(--accent);
  }

  .program-main p {
    color: var(--text-2);
    max-inline-size: 52ch;
  }

  .program-note {
    margin-block-start: var(--s-3);
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .program-main .more {
    margin-block-start: var(--s-4);
  }

  /* NCL has no photograph, so it gets a composed typographic panel rather than
     an empty frame. Never fabricate an image for symmetry. */
  .program-panel {
    display: grid;
    align-content: center;
    gap: var(--s-2);
    padding: clamp(var(--s-5), 4vw, var(--s-7));
    background: var(--accent-wash);
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    aspect-ratio: 4 / 3;
  }

  .panel-mark {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .panel-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .panel-years {
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: clamp(var(--s-6), 4vw, var(--s-8)) clamp(var(--s-5), 3vw, var(--s-7));
  }

  .origin {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s-6), 4vw, var(--s-8));
    align-items: center;
  }

  .origin-copy h2 {
    margin-block: var(--s-3) var(--s-4);
    max-inline-size: 20ch;
  }

  .origin-copy p {
    color: var(--text-2);
    max-inline-size: 52ch;
  }

  .origin-copy .more {
    margin-block-start: var(--s-5);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .giving,
    .origin {
      grid-template-columns: 1fr;
    }

    .program-panel {
      aspect-ratio: auto;
    }
  }
</style>
