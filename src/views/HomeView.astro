---
import EntryRow from "@/components/EntryRow.astro";
import Figure from "@/components/Figure.astro";
import Section from "@/components/Section.astro";
import { recentActivity } from "@/data/activity";
import { contributions } from "@/data/contributions";
import { programs } from "@/data/programs";
import { site } from "@/data/site";
import { lx, t, tDynamic } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import { formatAmount, formatDate } from "@/utils/format";
import type { Locale, Media } from "@/data/types";
import type { UIKey } from "@/i18n/ui";

export interface Props {
  lang: Locale;
}

const KIND_LABEL: Record<string, UIKey> = {
  news: "posts.kind.news",
  report: "posts.kind.report",
  story: "posts.kind.story",
  event: "nav.events",
};

const { lang } = Astro.props;

const hero: Media = {
  src: "/images/hero-1.webp",
  alt: {
    en: "Students in uniform walking together along a campus path.",
    kn: "ಶಾಲಾ ಸಮವಸ್ತ್ರದಲ್ಲಿ ವಿದ್ಯಾರ್ಥಿಗಳು ಆವರಣದ ಹಾದಿಯಲ್ಲಿ ಜೊತೆಯಾಗಿ ನಡೆಯುತ್ತಿದ್ದಾರೆ.",
  },
};

const campus: Media = {
  src: "/images/img2.webp",
  alt: {
    en: "Students seated in rows in the school hall.",
    kn: "ಶಾಲಾ ಸಭಾಂಗಣದಲ್ಲಿ ಸಾಲಾಗಿ ಕುಳಿತಿರುವ ವಿದ್ಯಾರ್ಥಿಗಳು.",
  },
};

// The record leads: real figures are the most convincing thing this site has.
const record = contributions.slice(0, 6);
// News and events only; contributions have their own block above.
const latest = recentActivity(14)
  .filter((item) => item.kind !== "contribution")
  .slice(0, 5);

const ignite = programs.find((program) => program.id === "ignite");
const ncl = programs.find((program) => program.id === "ncl");
---

<article class="home">
  <section class="masthead">
    <div class="container masthead-inner">
      <div>
        <h1 class="masthead-name">{lx(site.name, lang)}</h1>
        <p class="masthead-line">{lx(site.tagline, lang)}</p>
        <div class="masthead-actions">
          <a class="btn btn-primary" href={localePath("/contributions", lang)}>
            {t(lang, "home.explore")}
          </a>
          <a class="btn btn-secondary" href={localePath("/connect", lang)}>
            {t(lang, "home.connect")}
          </a>
        </div>
        <p class="masthead-facts">
          {t(lang, "site.formedShort")}
          <span aria-hidden="true"> · </span>
          {lx(site.contact.address, lang)}
        </p>
      </div>
      <Figure media={hero} locale={lang} ratio="4 / 3" priority={true} />
    </div>
  </section>

  <div class="container">
    <Section
      id="the-record"
      label={t(lang, "home.impactTitle")}
      lede={t(lang, "home.impactLede")}
      href={localePath("/contributions", lang)}
      linkLabel={t(lang, "common.viewAll")}
    >
      <ul class="ledger">
        {
          record.map((item) => (
            <EntryRow
              href={localePath(`/contributions/${item.slug}`, lang)}
              title={lx(item.title, lang)}
              date={formatDate(item.date, lang)}
              summary={lx(item.summary, lang)}
              image={item.image}
              amount={item.amount !== null ? formatAmount(item.amount, lang) : null}
              meta={[
                ...(item.batch ? [lx(item.batch, lang)] : []),
                ...(item.category ? [tDynamic(lang, `categories.${item.category}`)] : []),
              ]}
              locale={lang}
            />
          ))
        }
      </ul>
    </Section>

    <Section
      id="latest"
      label={t(lang, "home.latestTitle")}
      lede={t(lang, "home.latestLede")}
      href={localePath("/events", lang)}
      linkLabel={t(lang, "common.viewAll")}
    >
      {
        latest.length > 0 ? (
          <ul class="ledger">
            {latest.map((item) => (
              <EntryRow
                href={localePath(item.path, lang)}
                title={lx(item.title, lang)}
                date={formatDate(item.date, lang)}
                summary={lx(item.summary, lang)}
                image={item.image}
                locale={lang}
                meta={[t(lang, KIND_LABEL[item.kind])]}
              />
            ))}
          </ul>
        ) : (
          <p class="empty-state">{t(lang, "empty.generic")}</p>
        )
      }
    </Section>

    <Section id="programs" label={t(lang, "programs.title")} lede={t(lang, "programs.lede")}>
      <div class="programs">
        {
          ignite && (
            <article class="program program--lead">
              <h3>
                <a href={localePath("/programs/ignite", lang)}>{lx(ignite.name, lang)}</a>
              </h3>
              <p class="program-tagline">{lx(ignite.tagline, lang)}</p>
              <Figure media={ignite.image} locale={lang} ratio="3 / 2" />
              <p class="program-summary">{lx(ignite.summary, lang)}</p>
            </article>
          )
        }
        {
          ncl && (
            <article class="program">
              <h3>
                <a href={localePath("/programs/ncl", lang)}>{lx(ncl.name, lang)}</a>
              </h3>
              <p class="program-tagline">{lx(ncl.tagline, lang)}</p>
              <p class="program-summary">{lx(ncl.summary, lang)}</p>
              <p class="program-note mono">{lx(ncl.startNote, lang)}</p>
            </article>
          )
        }
      </div>
    </Section>
  </div>

  <section class="origin on-brand">
    <div class="container origin-inner">
      <div class="origin-text">
        <h2>{t(lang, "home.vidyalayaTitle")}</h2>
        <p>{t(lang, "home.vidyalayaLede")}</p>
        <a class="btn btn-secondary" href={localePath("/vidyalaya", lang)}>{t(lang, "nav.vidyalaya")}</a>
      </div>
      <Figure media={campus} locale={lang} ratio="4 / 3" />
    </div>
  </section>

  <div class="container">
    <Section
      id="connect"
      label={t(lang, "home.connectTitle")}
      lede={t(lang, "home.connectLede")}
    >
      <p class="connect-line">{t(lang, "home.mission")}</p>
      <a class="btn btn-primary" href={localePath("/connect", lang)}>{t(lang, "home.connect")}</a>
    </Section>
  </div>
</article>

<style>
  .programs {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(var(--s-5), 4vw, var(--s-8));
    align-items: start;
  }

  .program h3 {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .program--lead h3 {
    font-size: var(--step-3);
  }

  .program h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .program h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .program h3 {
    margin-block-start: 0;
  }

  .program :global(.figure) {
    margin-block-start: var(--s-4);
  }

  .program-tagline {
    margin-block-start: var(--s-2);
    font-weight: 600;
    color: var(--accent-program);
  }

  .program-summary {
    margin-block-start: var(--s-3);
    color: var(--text-2);
    max-inline-size: 52ch;
  }

  .program-note {
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-3);
    border-block-start: 1px solid var(--rule);
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .origin-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    padding-block: clamp(var(--s-7), 5.5vw, var(--s-9));
  }

  .origin-text p {
    margin-block-start: var(--s-4);
    max-inline-size: 46ch;
    font-size: var(--step-1);
  }

  .origin-text .btn {
    margin-block-start: var(--s-5);
    --btn-fg: var(--brand-ink);
    --btn-border: color-mix(in oklab, var(--brand-ink) 40%, var(--brand));
  }

  .origin-text .btn:hover {
    --btn-bg: color-mix(in oklab, var(--brand-ink) 14%, var(--brand));
  }

  .connect-line {
    font-size: var(--step-1);
    color: var(--text-2);
    max-inline-size: 56ch;
    margin-block-end: var(--s-5);
  }

  @media (max-width: 900px) {
    .programs,
    .origin-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
