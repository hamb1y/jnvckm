---
import Figure from "@/components/Figure.astro";
import PageCover from "@/components/PageCover.astro";
import { ArrowUpRight } from "lucide-astro";
import { site } from "@/data/site";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale, Media } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const group: Media = {
  src: "/images/23116700-10212457321081858-6312346336155469781-o.webp",
  alt: {
    en: "A large group photographed together on a sports ground, with trophies on the grass in front.",
    kn: "ಕ್ರೀಡಾ ಮೈದಾನದಲ್ಲಿ ಒಟ್ಟಿಗೆ ಚಿತ್ರೀಕರಿಸಿಕೊಂಡ ದೊಡ್ಡ ಗುಂಪು; ಮುಂದೆ ಹುಲ್ಲಿನ ಮೇಲೆ ಟ್ರೋಫಿಗಳು.",
  },
};

const work = [
  {
    en: "IGNITE — student-development and career-guidance sessions for classes 10 to 12",
    kn: "ಇಗ್ನೈಟ್ — 10ರಿಂದ 12ನೇ ತರಗತಿ ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ಅಭಿವೃದ್ಧಿ ಮತ್ತು ವೃತ್ತಿ ಮಾರ್ಗದರ್ಶನ ಅವಧಿಗಳು",
  },
  {
    en: "The Navodaya Cricket League — an annual alumni tournament built around batches",
    kn: "ನವೋದಯ ಕ್ರಿಕೆಟ್ ಲೀಗ್ — ಬ್ಯಾಚ್‌ಗಳ ಸುತ್ತ ನಡೆಯುವ ವಾರ್ಷಿಕ ಹಿರಿಯ ವಿದ್ಯಾರ್ಥಿ ಪಂದ್ಯಾವಳಿ",
  },
  {
    en: "The annual campus meet, reunions and city meet-ups",
    kn: "ವಾರ್ಷಿಕ ಆವರಣ ಸಮಾವೇಶ, ಪುನರ್ಮಿಲನಗಳು ಮತ್ತು ನಗರ ಭೇಟಿಗಳು",
  },
  {
    en: "Batch representatives who carry news to their own batchmates",
    kn: "ಸಂಘದ ಸುದ್ದಿಯನ್ನು ತಮ್ಮ ಬ್ಯಾಚ್‌ ಸ್ನೇಹಿತರಿಗೆ ತಲುಪಿಸುವ ಬ್ಯಾಚ್ ಪ್ರತಿನಿಧಿಗಳು",
  },
  {
    en: "Batch-led school projects — lighting, classrooms, laboratories, audio-visual and cultural facilities",
    kn: "ಬ್ಯಾಚ್‌ಗಳ ಶಾಲಾ ಯೋಜನೆಗಳು — ಬೆಳಕು, ತರಗತಿ ಕೊಠಡಿ, ಪ್ರಯೋಗಾಲಯ, ಶ್ರವ್ಯ-ದೃಶ್ಯ ಮತ್ತು ಸಾಂಸ್ಕೃತಿಕ ಸೌಲಭ್ಯಗಳು",
  },
  {
    en: "Support for students, staff and families in difficulty",
    kn: "ಕಷ್ಟದಲ್ಲಿರುವ ವಿದ್ಯಾರ್ಥಿಗಳು, ಸಿಬ್ಬಂದಿ ಮತ್ತು ಕುಟುಂಬಗಳಿಗೆ ಸಹಾಯ",
  },
];
---

<PageCover
  title={t(lang, "about.title")}
  lede={t(lang, "about.lede")}
  eyebrow={t(lang, "site.formedShort")}
/>

<section class="accent-brand">
  <div class="container about">
    <div class="about-media">
      <Figure media={group} locale={lang} ratio="4 / 3" showCaption={true} />
    </div>
    <div class="about-copy">
      <h2 class="section-title">{t(lang, "about.whatWeDo")}</h2>
      <ul class="work-list">
        {work.map((item) => (
          <li>{lx(item, lang)}</li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container">
    <p class="links">
      <a class="more" href={localePath("/programs", lang)}>
        {t(lang, "nav.programs")}
        <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
      </a>
      <a class="more" href={localePath("/contributions", lang)}>
        {t(lang, "nav.impact")}
        <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
      </a>
      <a class="more" href={localePath("/vidyalaya", lang)}>
        {t(lang, "nav.vidyalaya")}
        <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<section class="school-section">
  <div class="container school-grid">
    <h2 class="section-title">{t(lang, "about.schoolTitle")}</h2>
    <div>
      <p class="school-tagline">{lx(site.tagline, lang)}</p>
      <p class="school">{lx(site.schoolName, lang)}</p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s-7), 6vw, var(--s-10));
    align-items: start;
  }

  .about-media {
    position: sticky;
    inset-block-start: calc(var(--header-h) + var(--s-5));
  }

  .about-copy .section-title {
    font-size: var(--step-4);
    max-inline-size: 16ch;
  }

  .work-list {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    border-block-start: 2px solid var(--ink);
  }

  .work-list li {
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--rule);
    font-size: var(--step-1);
    line-height: 1.45;
    max-inline-size: 52ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-7);
    margin-block-start: clamp(var(--s-7), 6vw, var(--s-9));
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--rule);
  }

  .school-section {
    background: var(--surface-sunk);
  }

  .school-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--s-5) clamp(var(--s-6), 6vw, var(--s-9));
    align-items: baseline;
  }

  .school-tagline {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.25;
    letter-spacing: -0.02em;
    max-inline-size: 28ch;
  }

  .school {
    margin-block-start: var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  @media (max-width: 900px) {
    .about,
    .school-grid {
      grid-template-columns: 1fr;
    }

    .about-media {
      position: static;
    }
  }
</style>
