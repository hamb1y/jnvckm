---
import Figure from "@/components/Figure.astro";
import PageCover from "@/components/PageCover.astro";
import { ArrowUpRight } from "lucide-astro";
import { pages } from "@/data/pages";
import { site } from "@/data/site";
import { contributions } from "@/data/contributions";
import { programs } from "@/data/programs";
import { formatCount } from "@/utils/format";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const givingYears = contributions
  .map((entry) => entry.date.slice(0, 4))
  .filter(Boolean)
  .sort();

// Each onward link carries a real line from the records beneath its name.
const onward = [
  {
    path: "/programs",
    label: t(lang, "nav.programs"),
    note: programs
      .map((program) => (program.shortName && lx(program.shortName, lang)) || lx(program.name, lang))
      .join(" · "),
  },
  {
    path: "/contributions",
    label: t(lang, "nav.impact"),
    note: t(lang, "impact.summary")
      .replace("{count}", formatCount(contributions.length, lang))
      .replace("{from}", givingYears[0] ?? "")
      .replace("{to}", givingYears.at(-1) ?? ""),
  },
  {
    path: "/vidyalaya",
    label: t(lang, "nav.vidyalaya"),
    note: lx(site.schoolName, lang),
  },
];

const { photo, work } = pages.about;

---

<PageCover
  title={t(lang, "about.title")}
  lede={t(lang, "about.lede")}
  eyebrow={t(lang, "site.formedShort")}
/>

<section class="accent-brand">
  <div class="container about">
    <div class="about-media">
      {photo && <Figure media={photo} locale={lang} ratio="4 / 3" showCaption={true} />}
    </div>
    <div class="about-copy">
      <h2 class="section-title">{t(lang, "about.whatWeDo")}</h2>
      <ul class="work-list">
        {work.map((item) => (
          <li>{lx(item, lang)}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="closing">
  <div class="container">
    <p class="closing-line">{lx(site.tagline, lang)}</p>
    <ul class="links">
      {onward.map((item) => (
        <li>
          <a class="link-tile" href={localePath(item.path, lang)}>
            <span class="link-label">
              {item.label}
              <ArrowUpRight size={22} stroke-width={1.7} aria-hidden="true" />
            </span>
            <span class="link-note">{item.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s-7), 6vw, var(--s-10));
    align-items: start;
  }

  .about-media {
    position: sticky;
    inset-block-start: calc(var(--header-h) + var(--s-5));
  }

  .about-copy .section-title {
    font-size: var(--step-4);
    max-inline-size: 16ch;
  }

  .work-list {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    border-block-start: 2px solid var(--ink);
  }

  .work-list li {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--rule);
    font-size: var(--step-1);
    line-height: 1.45;
    max-inline-size: 52ch;
  }

  /* The back page: the association's line, then where to read on. */
  .closing {
    background: var(--surface-sunk);
  }

  .closing-line {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.15;
    letter-spacing: -0.025em;
    max-inline-size: 22ch;
    text-wrap: balance;
  }

  :global(:lang(kn)) .closing-line {
    letter-spacing: 0;
    line-height: 1.4;
  }

  .links {
    list-style: none;
    margin: clamp(var(--s-7), 5vw, var(--s-8)) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .link-tile {
    display: grid;
    align-content: space-between;
    gap: var(--s-6);
    block-size: 100%;
    padding: var(--s-5);
    background: var(--brand);
    color: var(--brand-ink);
    border-radius: var(--r-4);
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .link-label {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .link-note {
    color: var(--gold);
    font-size: var(--step-0);
    line-height: 1.4;
  }

  .link-tile :global(svg) {
    flex: none;
    color: var(--gold);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .link-tile:hover {
    background: var(--brand-deep);
  }

  .link-tile:hover :global(svg) {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about-media {
      position: static;
    }

    .links {
      grid-template-columns: 1fr;
    }
  }
</style>
