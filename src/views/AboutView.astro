---
import Figure from "@/components/Figure.astro";
import { site } from "@/data/site";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import type { Locale, Media } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const group: Media = {
  src: "/images/23116700-10212457321081858-6312346336155469781-o.webp",
  alt: {
    en: "A large group photographed together on a sports ground, with trophies on the grass in front.",
    kn: "ಕ್ರೀಡಾ ಮೈದಾನದಲ್ಲಿ ಒಟ್ಟಿಗೆ ಚಿತ್ರೀಕರಿಸಿಕೊಂಡ ದೊಡ್ಡ ಗುಂಪು; ಮುಂದೆ ಹುಲ್ಲಿನ ಮೇಲೆ ಟ್ರೋಫಿಗಳು.",
  },
};

const work = [
  {
    en: "IGNITE — student-development and career-guidance sessions for classes 10 to 12",
    kn: "ಇಗ್ನೈಟ್ — 10ರಿಂದ 12ನೇ ತರಗತಿ ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ಅಭಿವೃದ್ಧಿ ಮತ್ತು ವೃತ್ತಿ ಮಾರ್ಗದರ್ಶನ ಅವಧಿಗಳು",
  },
  {
    en: "The Navodaya Cricket League — an annual alumni tournament built around batches",
    kn: "ನವೋದಯ ಕ್ರಿಕೆಟ್ ಲೀಗ್ — ಬ್ಯಾಚ್‌ಗಳ ಸುತ್ತ ನಡೆಯುವ ವಾರ್ಷಿಕ ಹಿರಿಯ ವಿದ್ಯಾರ್ಥಿ ಪಂದ್ಯಾವಳಿ",
  },
  {
    en: "The annual campus meet, reunions and city meet-ups",
    kn: "ವಾರ್ಷಿಕ ಆವರಣ ಸಮಾವೇಶ, ಪುನರ್ಮಿಲನಗಳು ಮತ್ತು ನಗರ ಭೇಟಿಗಳು",
  },
  {
    en: "Batch representatives who carry news to their own batchmates",
    kn: "ಸಂಘದ ಸುದ್ದಿಯನ್ನು ತಮ್ಮ ಬ್ಯಾಚ್‌ ಸ್ನೇಹಿತರಿಗೆ ತಲುಪಿಸುವ ಬ್ಯಾಚ್ ಪ್ರತಿನಿಧಿಗಳು",
  },
  {
    en: "Batch-led school projects — lighting, classrooms, laboratories, audio-visual and cultural facilities",
    kn: "ಬ್ಯಾಚ್‌ಗಳ ಶಾಲಾ ಯೋಜನೆಗಳು — ಬೆಳಕು, ತರಗತಿ ಕೊಠಡಿ, ಪ್ರಯೋಗಾಲಯ, ಶ್ರವ್ಯ-ದೃಶ್ಯ ಮತ್ತು ಸಾಂಸ್ಕೃತಿಕ ಸೌಲಭ್ಯಗಳು",
  },
  {
    en: "Support for students, staff and families in difficulty",
    kn: "ಕಷ್ಟದಲ್ಲಿರುವ ವಿದ್ಯಾರ್ಥಿಗಳು, ಸಿಬ್ಬಂದಿ ಮತ್ತು ಕುಟುಂಬಗಳಿಗೆ ಸಹಾಯ",
  },
];
---

<div class="container">
  <header class="page-head">
    <h1>{t(lang, "about.title")}</h1>
    <p>{t(lang, "about.lede")}</p>
  </header>
</div>

<section class="accent-brand">
  <div class="container about">
    <div class="about-copy">
      <h2 class="section-title">{t(lang, "about.whatWeDo")}</h2>
      <ul class="work-list">
        {work.map((item) => <li>{lx(item, lang)}</li>)}
      </ul>
      <p class="links">
        <a href={localePath("/programs", lang)}>{t(lang, "nav.programs")}</a>
        <a href={localePath("/contributions", lang)}>{t(lang, "nav.impact")}</a>
        <a href={localePath("/vidyalaya", lang)}>{t(lang, "nav.vidyalaya")}</a>
      </p>
    </div>
    <div class="about-media">
      <Figure media={group} locale={lang} ratio="4 / 3" showCaption={true} />
    </div>
  </div>
</section>

<section class="accent-brand">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">{t(lang, "about.schoolTitle")}</h2>
    </div>
    <p class="measure">{lx(site.tagline, lang)}</p>
    <p class="measure school">{lx(site.schoolName, lang)}</p>
  </div>
</section>

<style>
  .container {
    padding-block-start: clamp(2rem, 5vw, 4rem);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: center;
  }

  .work-list {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .work-list li {
    position: relative;
    padding-inline-start: 1.1rem;
    font-size: var(--step-1);
    max-inline-size: 46ch;
  }

  .work-list li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin-block-start: var(--s-6);
    font-weight: 700;
  }

  .container > section {
    padding-block: 0;
  }

  section + section .container {
    padding-block-start: clamp(var(--s-7), 5vw, var(--s-9));
  }

  .school {
    margin-block-start: var(--s-4);
    color: var(--text-2);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
