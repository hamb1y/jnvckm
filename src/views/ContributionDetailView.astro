---
import type { MetaRow } from "@/components/EntryDetail.astro";
import EntryDetail from "@/components/EntryDetail.astro";
import { categoryLabel, contributionBySlug } from "@/data/contributions";
import { lx, t } from "@/i18n/utils";
import { localePath } from "@/lib/paths";
import { formatAmount } from "@/utils/format";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const entry = contributionBySlug(slug);
if (!entry) throw new Error(`Unknown contribution: ${slug}`);

const meta: MetaRow[] = [
  { label: t(lang, "common.category"), value: lx(categoryLabel(entry.category), lang) },
];
if (entry.batch) meta.push({ label: t(lang, "common.batch"), value: lx(entry.batch, lang) });
if (entry.amount !== null) {
  meta.push({ label: t(lang, "common.amount"), value: formatAmount(entry.amount, lang), figure: true });
}
---

<EntryDetail
  lang={lang}
  title={lx(entry.title, lang)}
  date={entry.date}
  summary={lx(entry.summary, lang)}
  meta={meta}
  body={entry.body}
  image={entry.image}
  documents={entry.documents}
  archiveNote={entry.archiveNote}
  source={entry.source}
  backHref={localePath("/contributions", lang)}
  backLabel={t(lang, "impact.title")}
/>
