---
/** The closing call to action, on the brand ground. */
export interface Props {
  kicker?: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { kicker, title, body, primaryHref, primaryLabel, secondaryHref, secondaryLabel } =
  Astro.props;
---

<section class="cta on-brand">
  <div class="container cta-inner">
    <div>
      {kicker && <p class="eyebrow cta-kicker">{kicker}</p>}
      <h2 class="cta-title">{title}</h2>
      <p class="cta-body">{body}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-light" href={primaryHref}>
        {primaryLabel}
      </a>
      {secondaryHref && secondaryLabel && (
        <a class="btn btn-ghost" href={secondaryHref}>
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }



  .cta-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(var(--s-6), 5vw, var(--s-9));
  }

  .cta-title {
    margin-block-start: var(--s-3);
    font-size: var(--step-5);
    max-inline-size: 14ch;
  }

  .cta-body {
    margin-block-start: var(--s-5);
    font-size: var(--step-1);
    max-inline-size: 44ch;
    color: var(--brand-muted);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .cta-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }
</style>
