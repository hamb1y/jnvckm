---
import { FOOTER_NAV } from "@/lib/nav";
import { localePath } from "@/lib/paths";
import { site } from "@/data/site";
import { lx, t } from "@/i18n/utils";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const siteName = lx(site.name, lang);
const schoolName = lx(site.schoolName, lang);
const year = new Date().getFullYear();
const { contact } = site;
// Only channels the association has confirmed are published as official.
const confirmedSocials = site.socials.filter((social) => social.verified);
---

<footer class="site-footer on-brand">
  <div class="container footer-top">
    <p class="footer-name">{siteName}</p>
    <p class="muted footer-independent">{t(lang, "footer.independent")}</p>
  </div>

  <div class="container footer-grid">
    <nav class="footer-block" aria-label={t(lang, "footer.association")}>
      <h2 class="footer-title">{t(lang, "footer.association")}</h2>
      <ul class="footer-list footer-pages">
        {FOOTER_NAV.map((item) => (
          <li>
            <a href={localePath(item.path, lang)}>{t(lang, item.key)}</a>
          </li>
        ))}
        {confirmedSocials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-block">
      <h2 class="footer-title">{t(lang, "connect.address")}</h2>
      <address class="footer-address">
        <span class="footer-school">{schoolName}</span>
        <span class="muted">{lx(site.contact.address, lang)}</span>
        {contact.emailVerified && contact.email ? (
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        ) : null}
        {contact.phoneVerified && contact.phone ? (
          <a href={`tel:${contact.phone.replace(/\s+/g, "")}`}>{contact.phone}</a>
        ) : null}
      </address>
    </div>
  </div>

  <div class="container footer-base">
    <p class="muted">
      © {year} {siteName} · {t(lang, "site.formedShort")}
    </p>
    <p class="muted footer-credit">
      {site.credit && (
        <>
          {t(lang, "footer.creditLabel")}{" "}
          <a href={site.credit.url} target="_blank" rel="noopener">
            {site.credit.label}
          </a>
        </>
      )}
      <span aria-hidden="true"> · </span>
      <a href={site.repository} target="_blank" rel="noopener">
        {t(lang, "footer.repository")}
      </a>
      {site.license && (
        <>
          <span aria-hidden="true"> · </span>
          <a href={site.license.url} target="_blank" rel="noopener">
            {site.license.label}
          </a>
        </>
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--s-9) var(--s-5);
    background: var(--brand-deep);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s-5) clamp(var(--s-6), 6vw, var(--s-9));
    align-items: end;
    padding-block-end: var(--s-7);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--gold);
    max-inline-size: 14ch;
    text-wrap: balance;
  }


  .footer-independent {
    max-inline-size: 48ch;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s-7) clamp(var(--s-6), 6vw, var(--s-9));
    padding-block-start: var(--s-6);
  }


  /* The rules sit inside the gutters, level with the text they divide. */
  .footer-grid,
  .footer-base {
    position: relative;
  }

  .footer-grid::before,
  .footer-base::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: var(--gutter);
    block-size: 1px;
    background: color-mix(in oklab, var(--brand-ink) 22%, var(--brand-deep));
  }

  .footer-title {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--gold);
    margin-block-end: var(--s-3);
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  /* Two columns, read down then across. */
  .footer-pages {
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    justify-content: start;
    column-gap: clamp(var(--s-6), 6vw, var(--s-9));
  }

  .footer-list a,
  .footer-address a {
    color: var(--brand-ink);
    text-decoration-color: color-mix(in oklab, var(--brand-ink) 40%, transparent);
  }

  .footer-list a:hover,
  .footer-address a:hover {
    text-decoration-color: var(--gold);
  }

  .footer-address {
    display: grid;
    gap: var(--s-2);
    font-style: normal;
  }

  .footer-school {
    color: var(--brand-ink);
    font-weight: 600;
  }

  .site-footer .muted {
    color: color-mix(in oklab, var(--brand-ink) 78%, var(--brand-deep));
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-4);
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .footer-top,
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
