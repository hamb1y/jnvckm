---
import { marked } from "marked";

export interface Props {
  value: string;
  class?: string;
}

const { value, class: className } = Astro.props;
// Links out of the site open in a new tab; links within it stay in this one.
const html =
  value.trim() === ""
    ? ""
    : (await marked.parse(value)).replace(/<a href="((?!https?:\/\/(?:www\.)?jnvckm\.org)https?:\/\/[^"]+)"/g, '<a href="$1" target="_blank" rel="noopener"');
---

{html !== "" && <div class:list={["prose", className]} set:html={html} />}

<style>
  .prose {
    max-inline-size: var(--measure);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block-start: var(--s-4);
  }

  .prose :global(p:first-child) {
    margin-block-start: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.3em;
    display: grid;
    gap: var(--s-2);
  }

  /* A quiet en dash, not a heavy bullet, so a list reads as text. */
  .prose :global(ul) {
    list-style: "–  ";
  }

  .prose :global(li::marker) {
    color: var(--text-3);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-block-start: var(--s-6);
  }

  .prose :global(a) {
    overflow-wrap: anywhere;
  }

  .prose :global(strong) {
    font-weight: 700;
  }
</style>
