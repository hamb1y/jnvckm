---
import Document from "./Document.astro";
import Figure from "./Figure.astro";
import Markdown from "./Markdown.astro";
import { ArrowLeft } from "lucide-astro";
import type { Locale, Localized, Media } from "@/data/types";
import { lx, t } from "@/i18n/utils";
import { formatDate } from "@/utils/format";

/**
 * Shared layout for a single event, contribution or story. One implementation
 * for three collections that render the same shape.
 */
export interface MetaRow {
  label: string;
  value: string;
  /** Links the value, e.g. an event's program. */
  href?: string;
  /** Sets the value as a figure, e.g. a contribution's amount. */
  figure?: boolean;
}

export interface Props {
  lang: Locale;
  title: string;
  /** ISO date, YYYY-MM-DD. */
  date?: string;
  summary?: string;
  meta?: MetaRow[];
  body: Localized;
  image?: Media | null;
  documents?: Media[];
  archiveNote?: Localized | null;
  source?: Localized;
  backHref: string;
  backLabel: string;
  priority?: boolean;
}

const {
  lang,
  title,
  date = "",
  summary = "",
  meta = [],
  body,
  image = null,
  documents = [],
  archiveNote = null,
  source = "",
  backHref,
  backLabel,
  priority = false,
} = Astro.props;

const bodyText = lx(body, lang);
const note = archiveNote ? lx(archiveNote, lang) : "";
const sourceText = lx(source, lang);
---

<article class:list={["entry", image && "entry--photo"]}>
  <header class="entry-cover">
    <div class="container">
      <a class="back-link" href={backHref}>
        <ArrowLeft size={15} stroke-width={1.8} aria-hidden="true" />
        {backLabel}
      </a>
      <div class="entry-head">
        {date !== "" && (
          <p class="entry-date">
            <time datetime={date}>{formatDate(date, lang)}</time>
          </p>
        )}
        <h1>{title}</h1>
        {summary !== "" && <p class="entry-lede">{summary}</p>}
      </div>
    </div>
  </header>

  <div class="container entry-body">
    {image && (
      <div class="entry-plate">
        <Figure media={image} locale={lang} ratio="16 / 9" priority={priority} showCaption />
      </div>
    )}

    {meta.length > 0 && (
      <dl class="record-strip entry-meta">
        {meta.map((row) => (
          <div class:list={[row.figure && "amount"]}>
            <dt>{row.label}</dt>
            <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {bodyText !== "" && <Markdown value={bodyText} class="entry-prose" />}

    {note !== "" && <aside class="entry-archive">{note}</aside>}

    {documents.length > 0 && (
      <section class="entry-documents">
        <h2 class="entry-documents-title">{t(lang, "common.documents")}</h2>
        <div class="document-grid">
          {documents.map((doc) => (
            <Document document={doc} locale={lang} />
          ))}
        </div>
      </section>
    )}

    {sourceText !== "" && (
      <p class="entry-source">
        {t(lang, "common.source")} · {sourceText}
      </p>
    )}

    <slot name="related" />
  </div>
</article>

<style>
  .entry-cover {
    background: var(--brand);
    color: var(--brand-ink);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  /* When there is a photograph, the cover runs on behind its top edge. */
  .entry--photo .entry-cover {
    padding-block-end: clamp(7rem, 16vw, 13rem);
  }

  .entry-cover .back-link {
    color: var(--brand-ink);
    border-color: var(--brand-rule);
  }

  .entry-cover .back-link:hover {
    border-color: var(--gold);
    background: var(--brand-2);
  }

  .entry-head {
    max-inline-size: 58rem;
    margin-block-start: var(--s-6);
  }

  .entry-date {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: var(--step-0);
    color: var(--gold);
    margin-block-end: var(--s-3);
  }

  .entry-head h1 {
    font-size: var(--step-5);
    max-inline-size: 20ch;
  }

  .entry-lede {
    margin-block-start: var(--s-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--brand-muted);
    max-inline-size: 52ch;
  }

  .entry-body {
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }

  .entry-plate {
    margin-block-start: calc(-1 * clamp(5rem, 13vw, 11rem));
    max-inline-size: 64rem;
  }

  .entry-meta {
    margin-block-start: var(--s-7);
    max-inline-size: 64rem;
  }

  .entry:not(.entry--photo) .entry-meta {
    margin-block-start: var(--s-7);
  }

  .entry-body :global(.entry-prose) {
    margin-block-start: var(--s-7);
    font-size: var(--step-1);
    line-height: 1.65;
  }

  .entry-note {
    margin-block-start: var(--s-5);
    padding: var(--s-3) var(--s-4);
    background: var(--surface-sunk);
    border-radius: var(--r-2);
    color: var(--text-2);
    max-inline-size: var(--measure);
  }

  .entry-archive {
    margin-block-start: var(--s-7);
    padding: var(--s-5) var(--s-6);
    background: var(--accent-program-wash);
    border-radius: var(--r-4);
    max-inline-size: var(--measure);
    color: var(--text-2);
  }

  .entry-documents {
    margin-block-start: var(--s-8);
    padding: 0;
  }

  .entry-documents-title {
    font-size: var(--step-3);
    margin-block-end: var(--s-5);
  }

  .document-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-5);
    align-items: start;
  }

  .entry-source {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--rule);
    color: var(--text-3);
    max-inline-size: var(--measure);
  }
</style>
