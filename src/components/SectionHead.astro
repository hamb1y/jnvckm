---
export interface Props {
  title: string;
  lede?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}

const { title, lede, href, linkLabel, id } = Astro.props;
---

<div class="section-head">
  <div class="section-lead-block">
    <h2 id={id}>{title}</h2>
    {lede !== undefined && lede !== "" && <p class="section-lede">{lede}</p>}
  </div>
  {
    href && linkLabel && (
      <a class="btn btn-secondary" href={href}>
        {linkLabel}
      </a>
    )
  }
</div>

<style>
  .section-lead-block {
    max-inline-size: var(--measure);
  }

  .section-lead-block h2 + .section-lede {
    margin-block-start: var(--s-2);
  }
</style>
