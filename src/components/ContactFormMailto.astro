---
import { getSiteSettings } from "../lib/content";

const formId = "contact-form";
const { contact } = getSiteSettings();
---

<div class="contact-card">
  <form id={formId}>
    <div>
       <label for={`${formId}-name`}>{contact.name_label}</label>
      <input id={`${formId}-name`} name="name" type="text" required autocomplete="name" />
    </div>
    <div>
       <label for={`${formId}-email`}>{contact.email_label}</label>
      <input id={`${formId}-email`} name="email" type="email" required autocomplete="email" />
    </div>
    <div>
       <label for={`${formId}-relation`}>{contact.relation_label}</label>
      <select id={`${formId}-relation`} name="relation" required>
         {contact.relation_options.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>
    <div>
       <label for={`${formId}-message`}>{contact.message_label}</label>
      <textarea id={`${formId}-message`} name="message" rows="4" required></textarea>
    </div>
     <button class="btn btn-primary" type="submit">{contact.submit_label}</button>
     <small>{contact.help_text}</small>
  </form>
</div>

<script is:inline>
  {`(() => {
     const targetEmail = ${JSON.stringify(contact.email)};
     const subjectText = ${JSON.stringify(contact.subject)};
    const form = document.getElementById("${formId}");
    if (!form) return;
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
       const name = data.get("name") || "";
       const emailInput = data.get("email") || "";
       const relation = data.get("relation") || "";
       const message = data.get("message") || "";
       const body = encodeURIComponent(\`Name: \${name}\\nEmail: \${emailInput}\\nRelation: \${relation}\\n\\nMessage:\\n\${message}\`);
      window.location.href = \`mailto:\${targetEmail}?subject=\${encodeURIComponent(subjectText)}&body=\${body}\`;
    });
  })();`}
</script>
