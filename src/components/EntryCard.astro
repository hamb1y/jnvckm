---
import { ArrowUpRight } from "lucide-astro";
import Figure from "./Figure.astro";
import type { Locale, Media } from "@/data/types";
import { formatDate } from "@/utils/format";

/**
 * A curated record on a card. The whole card is one click target: the title
 * link is stretched over it, so the photograph is clickable too and keyboard
 * focus still lands on real link text.
 *
 * A record with no photograph renders as an intentional text card, not an
 * empty frame.
 */
export interface Props {
  href: string;
  title: string;
  summary?: string;
  /** ISO date, YYYY-MM-DD. */
  date?: string;
  label?: string;
  location?: string;
  image?: Media | null;
  locale: Locale;
  accent?: "program" | "give" | "brand";
  ratio?: string;
}

const {
  href,
  title,
  summary = "",
  date = "",
  label = "",
  location = "",
  image = null,
  locale,
  accent = "brand",
  ratio = "3 / 2",
} = Astro.props;

const display = formatDate(date, locale);
---

<article class:list={["card", `accent-${accent}`, !image && "card--text"]}>
  {image && <Figure media={image} locale={locale} ratio={ratio} accent={accent} />}
  {!image && display !== "" && <p class="card-date">{display}</p>}

  <div class="meta mono">
    {display !== "" && <time class="date" datetime={date}>{display}</time>}
    {
      label !== "" && (
        <span class="label">
          <span class="dot" aria-hidden="true" />
          {label}
        </span>
      )
    }
  </div>

  <h3 class="title">
    <a href={href}>
      {title}
      <ArrowUpRight size={17} stroke-width={1.6} aria-hidden="true" />
    </a>
  </h3>

  {summary !== "" && <p class="summary">{summary}</p>}
  {location !== "" && <p class="place mono">{location}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  /* A record without a photograph gets a planned surface, not an empty box:
     the olive block of the report covers, with the date set large. */
  .card--text {
    padding: var(--s-5);
    background: var(--brand);
    border: 1px solid var(--brand-deep);
    border-radius: var(--r-2);
    color: var(--brand-ink);
    gap: var(--s-4);
  }

  .card-date {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
    color: color-mix(in oklab, var(--accent-program) 55%, var(--brand-ink));
  }

  .card--text .meta {
    color: color-mix(in oklab, var(--brand-ink) 74%, var(--brand));
  }

  .card--text .date {
    color: color-mix(in oklab, var(--brand-ink) 86%, var(--brand));
  }

  .card--text .label {
    color: color-mix(in oklab, var(--accent-program) 45%, var(--brand-ink));
  }

  .card--text .dot {
    background: color-mix(in oklab, var(--accent-program) 45%, var(--brand-ink));
  }

  .card--text .title a {
    color: var(--brand-ink);
  }

  .card--text .summary,
  .card--text .place {
    color: color-mix(in oklab, var(--brand-ink) 84%, var(--brand));
  }

  .card--text:has(.title a:hover) .summary,
  .card--text:has(.title a:hover) .date {
    color: var(--brand-ink);
  }

  .card--text .title a:focus-visible::after {
    outline-color: var(--brand-ink);
  }

  .card {
    transition: color var(--dur-1) var(--ease-out);
  }

  .card:has(.title a:hover) .summary,
  .card:has(.title a:hover) .date {
    color: var(--ink);
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .date {
    color: var(--text-2);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-weight: 600;
  }

  .dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .title {
    font-size: var(--step-2);
    margin: 0;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Stretch the one link over the whole card. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-2);
  }

  .title a:hover {
    color: var(--accent);
  }

  .title a:focus-visible::after {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .title :global(svg) {
    display: inline-block;
    vertical-align: baseline;
    margin-inline-start: 0.15em;
    color: var(--accent);
  }

  .summary {
    color: var(--text-2);
    max-inline-size: 58ch;
  }

  .place {
    font-size: var(--step--1);
    color: var(--text-3);
  }
</style>
