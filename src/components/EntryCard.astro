---
import { ArrowUpRight } from "lucide-astro";
import Figure from "./Figure.astro";
import type { Locale, Media } from "@/data/types";
import { formatDate } from "@/utils/format";

/**
 * A curated record on a card. The whole card is one click target: the title
 * link is stretched over it, so the photograph is clickable too and keyboard
 * focus still lands on real link text.
 *
 * A record with no photograph renders as an intentional text card, not an
 * empty frame.
 */
export interface Props {
  href: string;
  title: string;
  summary?: string;
  /** ISO date, YYYY-MM-DD. */
  date?: string;
  label?: string;
  location?: string;
  image?: Media | null;
  locale: Locale;
  accent?: "program" | "give" | "brand";
  ratio?: string;
}

const {
  href,
  title,
  summary = "",
  date = "",
  label = "",
  location = "",
  image = null,
  locale,
  accent = "brand",
  ratio = "3 / 2",
} = Astro.props;

const display = formatDate(date, locale);
// Keep hyphenated words whole, so "meet-up" never breaks after its hyphen.
const titleParts = title.split(/(\S*-\S*)/).filter((part) => part !== "");
---

<article class:list={["card", `accent-${accent}`, !image && "card--text"]}>
  {image && <Figure media={image} locale={locale} ratio={ratio} accent={accent} />}
  {!image && display !== "" && (
    <time class="card-date" datetime={date}>
      {display}
    </time>
  )}

  {((image && display !== "") || label !== "") && (
    <div class="meta">
      {image && display !== "" && (
        <time class="date" datetime={date}>
          {display}
        </time>
      )}
      {label !== "" && <span class="label">{label}</span>}
    </div>
  )}

  <h3 class="title">
    <a href={href}>
      {titleParts.map((part) => (part.includes("-") ? <span class="nowrap">{part}</span> : part))}
      <ArrowUpRight size={17} stroke-width={1.6} aria-hidden="true" />
    </a>
  </h3>

  {summary !== "" && <p class="summary">{summary}</p>}
  {location !== "" && <p class="place">{location}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .card :global(.figure) {
    margin-block-end: var(--s-2);
  }

  /* A record without a photograph gets a planned surface, not an empty box:
     the olive block of the report covers, with the date set large in gold. */
  .card--text {
    padding: clamp(var(--s-5), 3vw, var(--s-6));
    background: var(--brand);
    border-radius: var(--r-4);
    color: var(--brand-ink);
    gap: var(--s-4);
    min-block-size: 100%;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .card--text:has(.title a:hover) {
    background: var(--brand-deep);
  }

  .card-date {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 auto;
    padding-block-end: var(--s-6);
    color: var(--gold);
  }

  .card--text .meta {
    color: var(--brand-muted);
  }

  .card--text .label {
    color: var(--gold);
  }


  .card--text .title a {
    color: var(--brand-ink);
  }

  .card--text .title :global(svg) {
    color: var(--gold);
  }

  .card--text .summary,
  .card--text .place {
    color: var(--brand-muted);
  }

  .card--text .title a:focus-visible::after {
    outline-color: var(--brand-ink);
  }

  .card:has(.title a:hover) .summary,
  .card:has(.title a:hover) .date {
    color: var(--ink);
  }

  .card--text:has(.title a:hover) .summary,
  .card--text:has(.title a:hover) .date {
    color: var(--brand-ink);
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .date {
    color: var(--text-2);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-weight: 600;
  }


  .title {
    font-size: var(--step-2);
    font-weight: 400;
    margin: 0;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Stretch the one link over the whole card. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-4);
  }

  .card:not(.card--text) .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--accent-give);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .title :global(svg) {
    display: inline-block;
    vertical-align: baseline;
    margin-inline-start: 0.15em;
    color: var(--accent);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .card:has(.title a:hover) .title :global(svg) {
    transform: translate(2px, -2px);
  }

  .summary {
    color: var(--text-2);
    max-inline-size: 58ch;
  }

  .place {
    font-size: var(--step--1);
    color: var(--text-3);
  }
</style>
