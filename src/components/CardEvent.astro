---
interface EventCardProps {
  title: string;
  date: string;
  summary: string;
  slug: string;
  location?: string;
  tags?: string[];
}

const formatter = new Intl.DateTimeFormat("en-IN", {
  dateStyle: "medium",
});

const { title, date, summary, slug, location, tags = [] } = Astro.props as EventCardProps;
const label = formatter.format(new Date(date));
---

<article class="card event-card">
  <p class="eyebrow">{label}</p>
  <h3>
    <a href={`/events/${slug}`}>{title}</a>
  </h3>
  {location && <p class="meta">{location}</p>}
  <p>{summary}</p>
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
  )}
</article>

<style>
  .event-card .meta {
    color: rgba(4, 15, 20, 0.7);
    font-weight: 600;
  }
  .event-card .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .event-card .tags span {
    border: 1px solid var(--color-border-soft);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
    font-size: 0.85rem;
    background: rgba(26, 117, 159, 0.08);
  }
</style>
