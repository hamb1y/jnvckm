---
import { ImageOff } from "lucide-astro";
import type { FocalPosition, Locale, Media } from "@/data/types";
import { lx } from "@/i18n/utils";

/**
 * The one frame that owns image rendering: ratio, crop position, caption and an
 * explicit empty state. A record with no photograph gets a dashed panel rather
 * than a broken <img>.
 */
export interface Props {
  media: Media | null;
  locale: Locale;
  ratio?: string;
  priority?: boolean;
  showCaption?: boolean;
  /** Render a dashed panel when there is no image. Off by default. */
  placeholder?: boolean;
  placeholderLabel?: string;
  accent?: "program" | "give" | "brand";
  class?: string;
}

const POSITIONS: Record<FocalPosition, string> = {
  center: "50% 50%",
  top: "50% 0%",
  bottom: "50% 100%",
  left: "0% 50%",
  right: "100% 50%",
};

const {
  media,
  locale,
  ratio = "3 / 2",
  priority = false,
  showCaption = false,
  placeholder = false,
  placeholderLabel = "Photograph to be added",
  accent = "brand",
  class: className,
} = Astro.props;

const alt = media ? lx(media.alt, locale) : "";
const caption = media ? lx(media.caption ?? "", locale) : "";
const objectPosition = media?.position ? POSITIONS[media.position] : "50% 50%";
const captionText = caption !== "" ? caption : alt;
---

{
  media ? (
    <figure class:list={["figure", `accent-${accent}`, className]}>
      <img
        src={media.src}
        alt={alt}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        style={`aspect-ratio:${ratio};object-position:${objectPosition}`}
      />
      {showCaption && captionText !== "" && <figcaption>{captionText}</figcaption>}
    </figure>
  ) : placeholder ? (
    <figure class:list={["figure", "figure--empty", `accent-${accent}`, className]}>
      <div class="empty" style={`aspect-ratio:${ratio}`} role="img" aria-label={placeholderLabel}>
        <ImageOff size={22} stroke-width={1.4} aria-hidden="true" />
      </div>
    </figure>
  ) : null
}

<style>
  .figure {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--surface);
    border-radius: var(--r-2);
    overflow: hidden;
  }

  .figure img {
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    background: var(--surface-sunk);
  }

  .empty {
    display: grid;
    place-items: center;
    background: var(--surface-sunk);
    color: var(--text-3);
    position: relative;
  }

  .empty::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px dashed color-mix(in oklab, var(--text-3) 45%, transparent);
    border-radius: var(--r-1);
  }

  figcaption {
    padding: var(--s-2) var(--s-3);
    border-block-start: 1px solid var(--rule);
    background: var(--surface);
  }
</style>
