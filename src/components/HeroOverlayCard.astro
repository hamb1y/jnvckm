---
import { getSiteSettings } from "../lib/content";

const { hero, logo, logo_alt } = getSiteSettings();
---

<div class="hero-overlay-card">
  <img class="logo" src={logo} alt={logo_alt} width="72" height="72" />
  <p class="eyebrow">{hero.eyebrow}</p>
  <h1>{hero.title}</h1>
  <p>{hero.tagline}</p>
  <div class="actions">
    <a class="btn btn-primary" href={hero.primary_href}>{hero.primary_label}</a>
    <a class="btn btn-secondary" href={hero.secondary_href}>{hero.secondary_label}</a>
  </div>
</div>
