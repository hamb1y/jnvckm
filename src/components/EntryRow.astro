---
import type { Locale, Media } from "@/data/types";
import { lx } from "@/i18n/utils";

/**
 * One dated record in a ledger. The date sits in mono on the left, the record
 * carries the middle, the figure sits on the right where there is one, and a
 * small plate shows a photograph when the archive has one.
 */
export interface Props {
  href: string;
  title: string;
  date: string;
  meta?: string[];
  summary?: string;
  amount?: string | null;
  image?: Media | null;
  locale: Locale;
  /** Extra data-* attributes, used by the contributions filter. */
  attrs?: Record<string, string>;
}

const {
  href,
  title,
  date,
  meta = [],
  summary,
  amount = null,
  image = null,
  locale,
  attrs = {},
} = Astro.props;
const imageAlt = image ? lx(image.alt, locale) : "";
---

<li class="ledger-row" data-entry {...attrs}>
  <a class="ledger-link" href={href}>
    <time class="ledger-date mono" datetime={date}>{date}</time>
    <span class="ledger-main">
      <span class="ledger-title">{title}</span>
      {summary !== undefined && summary !== "" && <span class="ledger-summary">{summary}</span>}
      {
        meta.length > 0 && (
          <span class="ledger-meta mono">
            {meta.map((item, index) => (
              <span>
                {index > 0 && <span aria-hidden="true"> · </span>}
                {item}
              </span>
            ))}
          </span>
        )
      }
    </span>
    {amount !== null && <span class="ledger-amount mono">{amount}</span>}
    {
      image && (
        <img
          class="ledger-thumb"
          src={image.src}
          alt={imageAlt}
          width="160"
          height="107"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>
</li>

<style>
  .ledger-row {
    border-block-start: 1px solid var(--rule);
  }

  .ledger-row:last-child {
    border-block-end: 1px solid var(--rule);
  }

  .ledger-link {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto 4.5rem;
    align-items: start;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
    padding-inline: var(--s-2);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .ledger-link:hover {
    background: var(--surface);
  }

  .ledger-date {
    color: var(--text-3);
    font-size: var(--step--1);
    padding-block-start: 0.45em;
  }

  .ledger-main {
    display: grid;
    gap: var(--s-1);
  }

  .ledger-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .ledger-summary {
    color: var(--text-2);
    max-inline-size: 64ch;
  }

  .ledger-meta {
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .ledger-amount {
    color: var(--accent-give);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    text-align: end;
    padding-block-start: 0.1em;
  }

  .ledger-thumb {
    inline-size: 4.5rem;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-1);
    background: var(--surface-sunk);
  }

  @media (max-width: 720px) {
    .ledger-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-1) var(--s-4);
    }

    .ledger-date {
      grid-column: 1 / -1;
      padding-block-start: 0;
      margin-block-end: var(--s-2);
    }

    .ledger-amount {
      justify-self: end;
    }

    .ledger-thumb {
      grid-column: 2;
      grid-row: 2 / span 2;
      inline-size: 3.5rem;
    }
  }
</style>
