---
import type { Locale, Media } from "@/data/types";
import { lx } from "@/i18n/utils";
import { formatDate } from "@/utils/format";

/**
 * One dated record in a ledger. `date` is the ISO source date so the <time>
 * element carries machine-readable markup; the localised date is what is shown.
 * The date sits in mono on the left, the record carries the middle, the figure
 * sits on the right where there is one, and a small plate shows a photograph.
 */
export interface Props {
  href: string;
  title: string;
  /** ISO date, YYYY-MM-DD. */
  date: string;
  meta?: string[];
  summary?: string;
  amount?: string | null;
  image?: Media | null;
  locale: Locale;
  /** Extra data-* attributes, used by the contributions filter. */
  attrs?: Record<string, string>;
}

const {
  href,
  title,
  date,
  meta = [],
  summary,
  amount = null,
  image = null,
  locale,
  attrs = {},
} = Astro.props;

const display = formatDate(date, locale);
const imageAlt = image ? lx(image.alt, locale) : "";
---

<li class="ledger-row" data-entry {...attrs}>
  <a class="ledger-link" href={href}>
    <time class="ledger-date mono" datetime={date}>
      {display}
    </time>
    <span class="ledger-main">
      <span class="ledger-title">{title}</span>
      {summary !== undefined && summary !== "" && <span class="ledger-summary">{summary}</span>}
      {meta.length > 0 && (
        <span class="ledger-meta mono">
          {meta.map((item, index) => (
            <span>
              {index > 0 && <span aria-hidden="true"> · </span>}
              {item}
            </span>
          ))}
        </span>
      )}
    </span>
    {amount !== null && <span class="ledger-amount mono">{amount}</span>}
    {image && (
      <img
        class="ledger-thumb"
        src={image.src}
        alt={imageAlt}
        width="160"
        height="107"
        loading="lazy"
        decoding="async"
      />
    )}
  </a>
</li>

<style>
  .ledger-row {
    border-block-start: 1px solid var(--rule);
  }

  .ledger-row:last-child {
    border-block-end: 1px solid var(--rule);
  }

  .ledger-link {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto 7rem;
    align-items: start;
    gap: var(--s-2) var(--s-6);
    padding-block: var(--s-5);
    padding-inline: var(--s-3);
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--r-2);
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .ledger-link:hover {
    background: var(--surface);
  }

  .ledger-link:hover .ledger-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--accent-give);
  }

  .ledger-date {
    color: var(--text-3);
    font-size: var(--step--1);
    padding-block-start: 0.5em;
  }

  .ledger-main {
    display: grid;
    gap: var(--s-2);
  }

  .ledger-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .ledger-summary {
    color: var(--text-2);
    max-inline-size: 64ch;
  }

  .ledger-meta {
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .ledger-amount {
    font-family: var(--font-display);
    color: var(--accent-give);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .ledger-thumb {
    inline-size: 7rem;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-2);
    background: var(--surface-sunk);
    grid-column: 4;
  }

  @media (max-width: 720px) {
    .ledger-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-2) var(--s-4);
      padding-inline: 0;
    }

    .ledger-date {
      grid-column: 1 / -1;
      padding-block-start: 0;
    }

    .ledger-amount {
      grid-column: 1;
      justify-self: start;
      text-align: start;
    }

    .ledger-thumb {
      grid-column: 2;
      grid-row: 2 / span 2;
      inline-size: 4.5rem;
    }
  }
</style>
