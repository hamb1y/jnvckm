---
/**
 * A block of the page: a left rail that labels it, and a wide body that carries
 * it. Every section on the site uses this, which is what gives the pages a
 * consistent editorial rhythm instead of a stack of centred bands.
 */
export interface Props {
  /** The block's heading. Rendered in the rail. */
  label?: string;
  lede?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
  class?: string;
  /** Program blocks label in gold rather than ink. */
  program?: boolean;
}

const {
  label,
  lede,
  href,
  linkLabel,
  id,
  class: className,
  program = false,
} = Astro.props;
---

<section class:list={["section-block", className]} aria-labelledby={id}>
  <header class="rail">
    {label !== undefined && label !== "" && (
      <h2 class:list={["rail-label", program && "rail-label--program"]} id={id}>{label}</h2>
    )}
    {lede !== undefined && lede !== "" && <p class="rail-lede">{lede}</p>}
    {
      href && linkLabel && (
        <a class="rail-link" href={href}>
          {linkLabel}
        </a>
      )
    }
  </header>
  <div class="section-body">
    <slot />
  </div>
</section>
