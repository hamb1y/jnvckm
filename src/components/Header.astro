---
import { NAV, isActive } from "@/lib/nav";
import { alternatePath, localePath, stripLocale } from "@/lib/paths";
import { site } from "@/data/site";
import { lx, t } from "@/i18n/utils";
import type { Locale } from "@/data/types";

export interface Props {
  lang: Locale;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const here = stripLocale(pathname);
const other: Locale = lang === "en" ? "kn" : "en";
const otherHref = alternatePath(pathname, other);
const siteName = lx(site.name, lang);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath("/", lang)}>
      <img class="brand-mark" src="/logo-mark.webp" alt={siteName} width="420" height="193" />
    </a>

    <nav class="site-nav" aria-label={t(lang, "a11y.primaryNav")}>
      <details class="nav-details">
        <summary class="nav-summary">{t(lang, "a11y.menu")}</summary>
        <ul class="nav-list">
          {NAV.map((item) => (
            <li>
              <a
                href={localePath(item.path, lang)}
                aria-current={isActive(item, here) ? "page" : undefined}
              >
                {t(lang, item.key)}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <ul class="nav-list nav-inline">
        {NAV.map((item) => (
          <li>
            <a
              href={localePath(item.path, lang)}
              aria-current={isActive(item, here) ? "page" : undefined}
            >
              {t(lang, item.key)}
            </a>
          </li>
        ))}
      </ul>

      <a
        class="lang-switch"
        href={otherHref}
        hreflang={other}
        aria-label={t(lang, "lang.switchAria")}
      >
        {t(lang, "lang.switchLabel")}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Sticky, and a containing block for the absolutely positioned mobile menu. */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    border-block-end: 1px solid var(--rule);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-block-size: var(--header-h);
    padding-block: var(--s-2);
  }

  .brand {
    display: block;
    flex-shrink: 0;
  }

  .brand-mark {
    width: clamp(8rem, 18vw, 10rem);
    height: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: block;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.4rem 0.7rem;
    border-block-end: 2px solid transparent;
    transition:
      background-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .nav-list a:hover {
    border-block-end-color: var(--rule-strong);
  }

  .nav-inline a[aria-current="page"] {
    border-block-end-color: var(--brand);
    color: var(--brand);
  }

  .lang-switch {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-2);
    white-space: nowrap;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .lang-switch:hover {
    background: var(--brand-tint);
    border-color: var(--brand);
  }

  .nav-details {
    display: none;
  }

  .nav-summary {
    cursor: pointer;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-2);
    list-style: none;
    /* Push the marker to the far side so the label stays left-aligned. */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-width: 6.5rem;
  }

  .nav-summary::-webkit-details-marker {
    display: none;
  }

  .nav-summary::after {
    content: "";
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    rotate: 45deg;
    margin-block-start: -0.2rem;
    transition: rotate var(--dur-2) var(--ease-out);
  }

  .nav-details[open] .nav-summary {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--brand-ink);
  }

  .nav-details[open] .nav-summary::after {
    margin-block-start: 0.2rem;
    rotate: -135deg;
  }

  .nav-details .nav-list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin-block-start: var(--s-2);
  }

  .nav-details .nav-list a {
    display: block;
    padding: var(--s-3) 0;
    border-block-end: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .nav-details .nav-list a:hover {
    background: transparent;
    color: var(--accent-give);
  }

  .nav-details .nav-list a[aria-current="page"] {
    color: var(--accent-give);
  }

  @media (max-width: 1100px) {
    .header-inner {
      flex-wrap: wrap;
    }

    .nav-inline {
      display: none;
    }

    .nav-details {
      display: block;
    }

    .site-nav {
      gap: var(--s-3);
    }

    /* The open menu spans the full width, directly beneath the header bar. */
    .nav-details[open] .nav-list {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      padding: var(--s-2) var(--gutter) var(--s-5);
      background: var(--paper);
      border-block-end: 1px solid var(--rule);
      box-shadow: var(--shadow-lift);
      z-index: 20;
    }
  }

  @media (min-width: 1101px) {
    .nav-details {
      display: none;
    }
  }
</style>
