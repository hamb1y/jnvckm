---
const currentPath = Astro.url.pathname;

import { getSiteSettings } from "../lib/content";

const { navigation, logo, logo_alt } = getSiteSettings();
const navItems = navigation.map((item) => ({
  ...item,
  match: item.href.startsWith("/#") ? undefined : [item.href],
}));

const isActive = (matches?: string[]) =>
  matches?.some((match) => currentPath === match || currentPath.startsWith(`${match}/`));

const navId = `primary-nav-${Math.random().toString(36).slice(2, 8)}`;
---

<header class="site-header" data-nav-open="false">
  <div class="page-shell inner">
    <a class="brand" href="/">
      <img src={logo} alt={logo_alt} width="48" height="48" />
      <span>JNVCKM</span>
    </a>
    <button class="nav-toggle" type="button" aria-controls={navId} aria-expanded="false" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id={navId} aria-label="Site" data-open="false">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.match) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <script is:inline>
    (() => {
      const header = document.currentScript?.closest("header");
      const toggle = header?.querySelector(".nav-toggle");
      const nav = header?.querySelector("nav");
      if (!header || !toggle || !nav) return;

      const setState = (open) => {
        header.dataset.navOpen = String(open);
        nav.dataset.open = String(open);
        toggle.setAttribute("aria-expanded", String(open));
      };

      toggle.addEventListener("click", () => {
        const next = nav.dataset.open !== "true";
        setState(next);
      });

      nav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setState(false));
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 768) {
          setState(false);
        }
      });
    })();
  </script>
</header>
