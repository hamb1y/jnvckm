---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgramsView from "@/views/ProgramsView.astro";
import { t } from "@/i18n/utils";

const lang = "kn" as const;
---

<BaseLayout
  lang={lang}
  path="/programs"
  title={t(lang, "programs.title")}
  description={t(lang, "programs.lede")}
>
  <ProgramsView lang={lang} />
</BaseLayout>
