---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StoriesView from "@/views/StoriesView.astro";
import { t } from "@/i18n/utils";

const lang = "kn" as const;
---

<BaseLayout
  lang={lang}
  path="/stories"
  title={t(lang, "stories.title")}
  description={t(lang, "stories.lede")}
>
  <StoriesView lang={lang} />
</BaseLayout>
