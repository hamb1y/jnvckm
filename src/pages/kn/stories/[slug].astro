---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StoryDetailView from "@/views/StoryDetailView.astro";
import { posts } from "@/data/posts";
import { lx } from "@/i18n/utils";

export function getStaticPaths() {
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      title: lx(entry.title, "kn"),
      summary: lx(entry.summary, "kn"),
      image: entry.image ? entry.image.src : null,
    },
  }));
}

const lang = "kn" as const;
const { slug } = Astro.params;
const { title, summary, image } = Astro.props;
---

<BaseLayout
  lang={lang}
  path={`/stories/${slug}`}
  title={title}
  description={summary}
  image={image}
>
  <StoryDetailView lang={lang} slug={slug!} />
</BaseLayout>
