---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContributionsView from "@/views/ContributionsView.astro";
import { t } from "@/i18n/utils";

const lang = "kn" as const;
---

<BaseLayout
  lang={lang}
  path="/contributions"
  title={t(lang, "impact.title")}
  description={t(lang, "impact.lede")}
>
  <ContributionsView lang={lang} />
</BaseLayout>
