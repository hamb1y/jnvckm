---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ConnectView from "@/views/ConnectView.astro";
import { t } from "@/i18n/utils";

const lang = "en" as const;
---

<BaseLayout
  lang={lang}
  path="/connect"
  title={t(lang, "connect.title")}
  description={t(lang, "connect.lede")}
>
  <ConnectView lang={lang} />
</BaseLayout>
