---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VidyalayaView from "@/views/VidyalayaView.astro";
import { t } from "@/i18n/utils";

const lang = "en" as const;
---

<BaseLayout
  lang={lang}
  path="/vidyalaya"
  title={t(lang, "vidyalaya.title")}
  description={t(lang, "vidyalaya.lede")}
>
  <VidyalayaView lang={lang} />
</BaseLayout>
