---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardEvent from "../../components/CardEvent.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getEvents } from "../../lib/content";

const events = getEvents();
---

<BaseLayout title="Events | JNVCKM" description="Gatherings, outreach visits, and drives hosted by the JNVCKM community.">
  <section class="section page-shell">
    <SectionHeading
      eyebrow="Events"
      title="All events and outreach"
      description="Browse every alumni get‑together, campus visit, and student support drive."
    />
    {events.length > 0 ? (
      <div class="cards-grid">
        {events.map((event) => (
          <CardEvent {...event} />
        ))}
      </div>
    ) : (
      <p>No events are published yet. Use Decap CMS to add the first story.</p>
    )}
  </section>
</BaseLayout>
