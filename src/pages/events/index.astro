---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardEvent from "../../components/CardEvent.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getEvents, getSiteSettings } from "../../lib/content";

const events = getEvents();
const copy = getSiteSettings().pages.events;
---

<BaseLayout title={`${copy.title} | JNVCKM`} description={copy.description}>
  <section class="section page-shell">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
    />
    {events.length > 0 ? (
      <div class="cards-grid">
        {events.map((event) => (
          <CardEvent {...event} />
        ))}
      </div>
    ) : (
      <p>{copy.empty_text}</p>
    )}
  </section>
</BaseLayout>
