---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEvent, getEvents, getSiteSettings } from "../../lib/content";

export function getStaticPaths() {
  return getEvents().map((event) => ({
    params: { slug: event.slug },
  }));
}

const { slug } = Astro.params;
const event = slug ? getEvent(slug) : undefined;

if (!event) {
  return Astro.redirect("/404");
}

const formatter = new Intl.DateTimeFormat("en-IN", { dateStyle: "long" });
const formattedDate = formatter.format(new Date(event.date));
const { Content } = event;
const description = event.summary || `Updates from ${event.title}`;
const copy = getSiteSettings().pages.events;
---

<BaseLayout title={`${event.title} | JNVCKM Events`} description={description}>
  <article class="article-shell">
    <a class="back-link" href="/events">← {copy.back_label}</a>
    <div class="article-meta">
      <p class="eyebrow">{formattedDate}</p>
      {event.location && <p class="meta">{copy.type_label}: {event.location}</p>}
    </div>
    {event.tags && event.tags.length > 0 && (
      <div class="tag-list">
        {event.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )}
    {event.thumbnail && (
      <div class="article-figure">
        <img src={event.thumbnail} alt={event.title} loading="lazy" decoding="async" />
      </div>
    )}
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
