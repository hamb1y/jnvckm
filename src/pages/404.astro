---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings } from "../lib/content";

const copy = getSiteSettings().pages.not_found;
---

<BaseLayout title={`${copy.title} | JNVCKM`}>
  <section class="section page-shell" style="text-align:center;">
    <p class="eyebrow">404</p>
    <h1>{copy.title}</h1>
    <p>{copy.description}</p>
    <a class="btn btn-primary" href="/">{copy.home_label}</a>
  </section>
</BaseLayout>
