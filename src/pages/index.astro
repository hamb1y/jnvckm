---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardContribution from "../components/CardContribution.astro";
import CardEvent from "../components/CardEvent.astro";
import ContactFormMailto from "../components/ContactFormMailto.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import HeroOverlayCard from "../components/HeroOverlayCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getContributions, getEvents, getSiteSettings } from "../lib/content";

const events = getEvents();
const contributions = getContributions();
const site = getSiteSettings();
const heroSlides = site.hero.slides.map((slide) => ({ src: slide.image, alt: slide.alt }));
---

<BaseLayout>
  <section class="hero">
    <div class="hero-grid">
      <HeroCarousel slides={heroSlides} />
      <HeroOverlayCard />
    </div>
  </section>

  <section id="about" class="section page-shell">
    <SectionHeading
      eyebrow={site.about.eyebrow}
      title={site.about.title}
      description={site.about.description}
    />
    <div class="cards-grid">
      {site.about.cards.map((card) => (
        <article class="card">
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section page-shell">
    <SectionHeading
      eyebrow={site.events_section.eyebrow}
      title={site.events_section.title}
      description={site.events_section.description}
    />
    {events.length > 0 ? (
      <>
        <div class="cards-grid">
          {events.slice(0, 3).map((event) => (
            <CardEvent {...event} />
          ))}
        </div>
        <div style="margin-top:1.5rem;">
          <a class="btn btn-secondary" href="/events">{site.events_section.link_label}</a>
        </div>
      </>
    ) : (
      <p>{site.pages.events.empty_text}</p>
    )}
  </section>

  <section class="section page-shell">
    <SectionHeading
      eyebrow={site.contributions_section.eyebrow}
      title={site.contributions_section.title}
      description={site.contributions_section.description}
    />
    {contributions.length > 0 ? (
      <>
        <div class="cards-grid">
          {contributions.slice(0, 3).map((item) => (
            <CardContribution {...item} />
          ))}
        </div>
        <div style="margin-top:1.5rem;">
          <a class="btn btn-secondary" href="/contributions">{site.contributions_section.link_label}</a>
        </div>
      </>
    ) : (
      <p>{site.pages.contributions.empty_text}</p>
    )}
  </section>

  <section id="faq" class="section page-shell">
    <SectionHeading
      eyebrow={site.faq_section.eyebrow}
      title={site.faq_section.title}
      description={site.faq_section.description}
      align="center"
    />
    <FAQAccordion />
  </section>

  <section id="contact" class="section page-shell">
    <SectionHeading
      eyebrow={site.contact.eyebrow}
      title={site.contact.title}
      description={site.contact.description}
    />
    <ContactFormMailto />
  </section>
</BaseLayout>
