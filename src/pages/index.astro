---
import type { MarkdownInstance } from "astro";
import fs from "node:fs/promises";

import BaseLayout from "../layouts/BaseLayout.astro";
import CardContribution from "../components/CardContribution.astro";
import CardEvent from "../components/CardEvent.astro";
import ContactFormMailto from "../components/ContactFormMailto.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import HeroOverlayCard from "../components/HeroOverlayCard.astro";
import SectionHeading from "../components/SectionHeading.astro";

type EventFrontmatter = {
  title: string;
  date: string;
  location?: string;
  summary: string;
  tags?: string[];
  featured?: boolean;
};

type ContributionFrontmatter = {
  title: string;
  date: string;
  type?: string;
  initiated_by?: string;
  summary: string;
  tags?: string[];
};

const eventModules = import.meta.glob<MarkdownInstance<EventFrontmatter>>("../../content/events/*.md", {
  eager: true,
});
const contributionModules = import.meta.glob<MarkdownInstance<ContributionFrontmatter>>(
  "../../content/contributions/*.md",
  { eager: true }
);

const events = Object.entries(eventModules)
  .map(([path, entry]) => ({
    slug: path.split("/").pop()?.replace(".md", "") ?? "",
    ...entry.frontmatter,
  }))
  .filter((event) => event.title && event.date)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const contributions = Object.entries(contributionModules)
  .map(([path, entry]) => ({
    slug: path.split("/").pop()?.replace(".md", "") ?? "",
    ...entry.frontmatter,
  }))
  .filter((item) => item.title && item.date)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const heroDir = new URL("../../public/hero", import.meta.url);
const heroFiles = await fs.readdir(heroDir).catch(() => []);
const heroSlides =
  heroFiles
    .filter((file) => /\.(png|jpe?g|webp)$/i.test(file))
    .sort()
    .map((file, index) => ({
      src: `/hero/${file}`,
      alt: `JNVCKM highlight ${index + 1}`,
    })) ?? [];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-grid">
      <HeroCarousel client:load slides={heroSlides} />
      <HeroOverlayCard />
    </div>
  </section>

  <section id="about" class="section page-shell">
    <SectionHeading
      eyebrow="About JNVCKM"
      title="Residential learning rooted in community"
      description="Established on 23 October 1986, JNV Chikkamagluru nurtures talented rural students through free, residential CBSE education backed by Navodaya Vidyalaya Samiti."
    />
    <div class="cards-grid">
      <article class="card">
        <h3>PM SHRI Campus</h3>
        <p>Spread across 15 serene acres near Balehonnur with dedicated classrooms, science labs, music &amp; art rooms, and modern residential blocks.</p>
      </article>
      <article class="card">
        <h3>Whole-child focus</h3>
        <p>Sports grounds, NCC, Scouts &amp; Guides, Youth Parliament, and cultural clubs keep students rooted while expanding their horizons.</p>
      </article>
      <article class="card">
        <h3>Alumni network</h3>
        <p>Graduates serve as mentors, donors, and champions, ensuring the Navodaya spirit of giving back remains alive for every new batch.</p>
      </article>
    </div>
  </section>

  <section class="section page-shell">
    <SectionHeading
      eyebrow="Events"
      title="Upcoming and recent gatherings"
      description="Stay informed about reunions, outreach visits, and student support drives."
    />
    {events.length > 0 ? (
      <>
        <div class="cards-grid">
          {events.slice(0, 3).map((event) => (
            <CardEvent {...event} />
          ))}
        </div>
        <div style="margin-top:1.5rem;">
          <a class="btn btn-secondary" href="/events">Browse all events</a>
        </div>
      </>
    ) : (
      <p>No events published yet. Use Decap CMS to add the first story.</p>
    )}
  </section>

  <section class="section page-shell">
    <SectionHeading
      eyebrow="Contributions"
      title="How alumni give back"
      description="Scholarships, infrastructure upgrades, and mentoring programs led by batches across decades."
    />
    {contributions.length > 0 ? (
      <>
        <div class="cards-grid">
          {contributions.slice(0, 3).map((item) => (
            <CardContribution {...item} />
          ))}
        </div>
        <div style="margin-top:1.5rem;">
          <a class="btn btn-secondary" href="/contributions">See all contributions</a>
        </div>
      </>
    ) : (
      <p>No contributions recorded yet.</p>
    )}
  </section>

  <section id="faq" class="section page-shell">
    <SectionHeading
      eyebrow="FAQs"
      title="Questions from alumni and parents"
      description="Answers collected from the community and school leadership."
      align="center"
    />
    <FAQAccordion />
  </section>

  <section id="contact" class="section page-shell">
    <SectionHeading
      eyebrow="Contact"
      title="Reach the alumni coordination team"
      description="Share collaboration ideas, volunteer for drives, or simply say hello."
    />
    <ContactFormMailto />
  </section>
</BaseLayout>
