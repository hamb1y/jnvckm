---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutView from "@/views/AboutView.astro";
import { t } from "@/i18n/utils";

const lang = "en" as const;
---

<BaseLayout
  lang={lang}
  path="/about"
  title={t(lang, "about.title")}
  description={t(lang, "about.lede")}
>
  <AboutView lang={lang} />
</BaseLayout>
