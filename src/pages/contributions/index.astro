---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardContribution from "../../components/CardContribution.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getContributions } from "../../lib/content";

const contributions = getContributions();
---

<BaseLayout
  title="Contributions | JNVCKM"
  description="Scholarships, infrastructure upgrades, and mentoring programs led by alumni batches."
>
  <section class="section page-shell">
    <SectionHeading
      eyebrow="Contributions"
      title="Every way alumni give back"
      description="Financial aid, mentorship, and school improvements powered by the JNVCKM network."
    />
    {contributions.length > 0 ? (
      <div class="cards-grid">
        {contributions.map((item) => (
          <CardContribution {...item} />
        ))}
      </div>
    ) : (
      <p>No contributions captured yet. Publish the first story from Decap CMS.</p>
    )}
  </section>
</BaseLayout>
