---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardContribution from "../../components/CardContribution.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getContributions, getSiteSettings } from "../../lib/content";

const contributions = getContributions();
const copy = getSiteSettings().pages.contributions;
---

<BaseLayout
  title={`${copy.title} | JNVCKM`}
  description={copy.description}
>
  <section class="section page-shell">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
    />
    {contributions.length > 0 ? (
      <div class="cards-grid">
        {contributions.map((item) => (
          <CardContribution {...item} />
        ))}
      </div>
    ) : (
      <p>{copy.empty_text}</p>
    )}
  </section>
</BaseLayout>
