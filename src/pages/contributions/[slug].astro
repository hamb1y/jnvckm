---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getContribution } from "../../lib/content";

const { slug } = Astro.params;
const contribution = slug ? getContribution(slug) : undefined;

if (!contribution) {
  return Astro.redirect("/404");
}

const formatter = new Intl.DateTimeFormat("en-IN", { dateStyle: "long" });
const formattedDate = formatter.format(new Date(contribution.date));
const { Content } = contribution;
const description = contribution.summary || `Contribution update from ${contribution.title}`;
---

<BaseLayout title={`${contribution.title} | JNVCKM Contributions`} description={description}>
  <article class="article-shell">
    <a class="back-link" href="/contributions">← All contributions</a>
    <div class="article-meta">
      <p class="eyebrow">{formattedDate}</p>
      {contribution.type && <p class="meta">Type: {contribution.type}</p>}
      {contribution.initiated_by && <p class="meta">Initiated by: {contribution.initiated_by}</p>}
    </div>
    {contribution.tags && contribution.tags.length > 0 && (
      <div class="tag-list">
        {contribution.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )}
    {contribution.thumbnail && (
      <div class="article-figure">
        <img src={contribution.thumbnail} alt={contribution.title} loading="lazy" decoding="async" />
      </div>
    )}
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
